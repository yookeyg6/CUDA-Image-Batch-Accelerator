cmake_minimum_required(VERSION 3.18)
project(cuda_capstone LANGUAGES CXX CUDA)
set(CMAKE_CXX_STANDARD 17)
set(CMAKE_CXX_STANDARD_REQUIRED ON)
add_executable(cuda_capstone src/main.cu src/cuda_processor.cu)
target_include_directories(cuda_capstone PRIVATE include)
set_target_properties(cuda_capstone PROPERTIES CUDA_SEPARABLE_COMPILATION ON)
